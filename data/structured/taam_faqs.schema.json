{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valledellili.org/schemas/taam-faqs-structured-2020-12.json",
  "title": "FAQs estructuradas TAAM (postoperatorio demo)",
  "type": "object",
  "additionalProperties": false,
  "required": ["faqs"],
  "properties": {
    "faqs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/faq_entrada" }
    }
  },
  "$defs": {
    "faq_entrada": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "intent",
        "keywords",
        "pregunta_canonica",
        "respuesta",
        "actualizado_el"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "pregunta_canonica": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "respuesta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "source_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actualizado_el": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
