# Type checkers & linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Environments and secrets
.env
!.env.example
!**/.env.example
*.env
!*.env.example
secrets/

# ML / LLM: checkpoints and large artifacts (un-ignore a path with !path/to/file if needed)
models/
checkpoints/
# Crudo: ignorar hijos directos de data/raw salvo valledellili-org (versionado curado).
data/raw/*
!data/raw/valledellili-org/
# Salidas en processed (chunks, etc.); se versiona la carpeta de evaluación con .gitkeep.
data/processed/**
!data/processed/
!data/processed/evaluaciones/
data/processed/evaluaciones/*
!data/processed/evaluaciones/.gitkeep
lightning_logs/
wandb/
mlruns/
*.pt
*.pth
*.ckpt
# Weights often named with .bin (e.g. HF); un-ignore with ! if a small .bin must be versioned
*.bin
*.safetensors
*.h5
*.hdf5
*.onnx
*.npy
*.npz

# Hugging Face / project caches (optional: comment out if you must version something here)
# .cache/

# OS
.DS_Store
Thumbs.db

# IDEs
.idea/

# Node: dependencias en cualquier paquete (monorepo / scripts en raiz)
node_modules/

# Almacen de paquetes de pnpm si store-dir apunta dentro del repo (evita miles de archivos UT)
.pnpm-store/

