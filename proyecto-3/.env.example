# proyecto-3 — Ruta B OpenFang (copiar a .env; no commitear .env)

# Raiz del workspace (corpus data/markdown y data/taam).
# Por defecto: padre de proyecto-3/ si existe data/markdown/
# UAO_WORKSPACE_ROOT=/ruta/al/repo

# OpenFang — directorio de datos runtime (SQLite, JSONL).
# Ruta relativa al directorio proyecto-3/ (no a la raiz del monorepo).
OPENFANG_HOME=./openfang/data

# UUID del agente OpenFang para ingesta (opcional; si vacio se resuelve via GET /api/status)
# OPENFANG_AGENT_ID=

# URL del daemon OpenFang (healthcheck y KV resumen de ingesta)
OPENFANG_API_URL=http://127.0.0.1:4200

# OpenAI (LLM del agente y embeddings t-SNE)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Telegram — bot dedicado Ruta B (distinto al de proyecto-2)
TELEGRAM_BOT_TOKEN=

# Logging de scripts Python auxiliares
LOG_LEVEL=INFO

# Fallback opcional si OpenFang no integra OpenAI en tu version
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
