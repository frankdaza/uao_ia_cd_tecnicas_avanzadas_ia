# ==============================
# Backend API
# ==============================
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
API_PORT=8000

# ==============================
# Ollama
# ==============================
OLLAMA_BASE_URL=http://localhost:11434
MODELO_LLM_DEFECTO=llama3.1:8b
# Ventana de contexto Ollama (entero entre 1024 y 16384 inclusive; defecto 8192).
# OLLAMA_NUM_CTX=8192
URL_BASE_SITIO=https://valledellili.org/
# Opcional: user-agent del crawler (si no, se usa el defecto de src.scraping.robots).
# USER_AGENT=

# OpenAI (API en la nube; no commitees valores reales)
# OPENAI_API_KEY=
# Opcional: proxy compatible (p. ej. LiteLLM) o endpoint alterno.
# OPENAI_BASE_URL=https://api.openai.com/v1
# La UI usa por defecto gpt-4o-mini (menor posibilidad de 429 en cuentas con límites bajos).
# Opcional: tope de tokens de la respuesta (entero positivo). Sin valor = no se limita en API.
# OPENAI_MAX_COMPLETION_TOKENS=

# ==============================
# PostgreSQL (Módulo 2 — OLTP, usuarios, historial LangChain)
# ==============================
# Host y puerto del servicio Postgres (p. ej. docker-compose o instancia administrada).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
# Contraseña local de ejemplo; en producción usar secretos del orquestador, no valores en git.
POSTGRES_PASSWORD=cambiar_en_local
# URL async para SQLAlchemy 2 + asyncpg. Si la defines, tiene prioridad sobre el ensamble POSTGRES_*.
# Formato: postgresql+asyncpg://USUARIO:CONTRASENA@HOST:PUERTO/BASE
DATABASE_URL=postgresql+asyncpg://postgres:cambiar_en_local@localhost:5432/app

# ==============================
# Qdrant (Módulo 2 — vectores del corpus)
# ==============================
# URL HTTP del servidor Qdrant (sin barra final).
QDRANT_URL=http://localhost:6333
# Opcional: API key si el cluster la exige (dejar vacío en desarrollo local).
# QDRANT_API_KEY=
QDRANT_COLLECTION=corpus_fvl
# Métrica de distancia en la colección (valor tipico: Cosine).
QDRANT_DISTANCE=Cosine

# ==============================
# Embeddings (Módulo 2 — ingesta y consulta RAG)
# ==============================
# Proveedor: openai (defecto del curso) o huggingface (requiere paquete extra y modelo local; ver README).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Dimension del vector (debe coincidir con el modelo; 1536 para text-embedding-3-small).
EMBEDDING_DIMS=1536

# ==============================
# Chunking (Módulo 2 — ingesta Markdown hacia Qdrant)
# ==============================
CHUNK_SIZE=512
CHUNK_OVERLAP=80
# Estrategia documentada para scripts de ingesta (p. ej. sentence, fixed).
CHUNK_STRATEGY=sentence

# ==============================
# RAG denso (Módulo 2 — runtime del agente)
# ==============================
RAG_TOP_K=5
# Umbral minimo de similitud o score normalizado segun implementacion del recuperador.
RAG_SCORE_MINIMO=0.25

# ==============================
# Memoria conversacional (Módulo 2)
# ==============================
# Antiguedad maxima de mensajes inyectados al router (dias).
HISTORIAL_DIAS_MAX=7
# Tope adicional de turnos (usuario+asistente) si la implementacion lo aplica.
HISTORIAL_TURNOS_MAX=20

# ==============================
# FAQ estructurada (Módulo 2 — tool determinista)
# ==============================
# Umbral de coincidencia para considerar una FAQ como match (0.0 a 1.0).
FAQ_UMBRAL_MATCH=0.5

# ==============================
# Router LangGraph (Módulo 2)
# ==============================
# Ruta al JSON de meta-prompt del router (relativa al directorio de trabajo de la API).
ROUTER_META_PROMPT_PATH=config/router_meta_prompt.json
# Modelo de chat para decision de herramientas y composicion (compatible con OpenAI API).
ROUTER_LLM_MODEL=gpt-4o-mini
