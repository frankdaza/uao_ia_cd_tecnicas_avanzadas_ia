# Copiar a `.env` en la raiz del repositorio y completar valores reales.
# No commitear `.env` con secretos.
# Cada variable debe empezar al inicio de linea con NOMBRE=valor (sin espacios antes del nombre).

OPENAI_API_KEY=

# Lista JSON (CORS). Debe incluir el origen exacto del navegador (p. ej. Vite en 5173 o la API sirviendo el SPA en 8000).
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Laboratorio sin OpenAI (router/compositor mock). Valores tipicos: 0 o 1.
MOCK_LLM=0

# Docker Compose (opcional): publicacion de Postgres en el host.
# POSTGRES_PUBLISH_PORT=15432

# Panel admin M2: cabecera X-Admin-Key (sin valor = rutas /api/admin responden 503)
ADMIN_API_KEY=

# Chunking ingesta Qdrant (SentenceSplitter en scripts/indexar_corpus_qdrant.py).
# Reiniciar API o script tras cambiar .env: obtener_configuracion() usa lru_cache.
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
# Reservado; la ingesta actual no cambia de estrategia con este valor.
CHUNK_STRATEGY=sentence

# --- RAG denso (Qdrant; reiniciar proceso tras cambiar) ---
# RAG_TOP_K: fragmentos finales al compositor. RAG_SCORE_MINIMO: umbral coseno (0-1).
# RAG_TOP_K_INICIAL: candidatos pedidos a Qdrant antes de MMR/rerank (sobrerrecuperacion).
# RAG_MMR_HABILITADO: 1/true activa diversidad MMR. RAG_MMR_LAMBDA: 0.0-1.0 (1.0 = sin diversidad).
# RAG_RERANKER_HABILITADO: 1/true carga cross-encoder local (latencia extra; requiere sentence-transformers).
# RAG_RERANKER_MODELO: id HuggingFace (p. ej. BAAI/bge-reranker-base). RAG_RERANKER_TOP_N_ENTRADA: pares al reranker.
RAG_TOP_K=5
RAG_SCORE_MINIMO=0.25
RAG_TOP_K_INICIAL=20
RAG_MMR_HABILITADO=true
RAG_MMR_LAMBDA=0.5
RAG_RERANKER_HABILITADO=false
RAG_RERANKER_MODELO=BAAI/bge-reranker-base
RAG_RERANKER_TOP_N_ENTRADA=10
