# Copiar a `.env` en proyecto-2/ y completar valores reales.
# No commitear `.env` con secretos.

# --- Workspace (opcional) ---
# Directorio que contiene data/ (por defecto: padre de proyecto-2/)
# UAO_WORKSPACE_ROOT=

# --- API TAAM ---
# Puerto local / compose (M2 usa 8000)
API_PORT=8001
# Vite dev en compose (M2 usa 5173)
FRONTEND_PORT=5174

# Lista JSON (CORS). Incluir origen del frontend Vite TAAM (5174) y la API (8001).
ALLOWED_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","http://localhost:8001","http://127.0.0.1:8001"]

# --- Telegram (TASK-106) ---
# Si el token aparece en logs (p. ej. traceback httpx), revocarlo en @BotFather y generar uno nuevo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Recordatorios proactivos (UC-MVP-04) ---
# Defaults al crear la fila config_operativa_taam (primer arranque). Luego use el panel admin
# (Administracion > Recordatorios programados) o PATCH /api/admin/recordatorios-job.
# En desarrollo local sin Telegram real: false evita envios automaticos hasta activarlo en UI.
# Con semilla demo (chat_id 111111111 / 222222222) el codigo omite envios ficticios aun con job true.
RECORDATORIOS_JOB_HABILITADO=false
# Segundos entre recordatorios del mismo caso (1., 2., 3. plantilla) y entre ciclos del job.
RECORDATORIOS_JOB_INTERVAL_SEG=60
# Zona IANA para mostrar fechas en el panel (no programa envios en MVP actual).
TAAM_ZONA_HORARIA=America/Bogota

# --- Datos (TASK-99+) ---
# Desde el host con compose: localhost y POSTGRES_PUBLISH_PORT (15433 por defecto)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15433/taam?sslmode=disable

# Qdrant REST en el host (6334 por defecto; dentro de compose es http://qdrant:6333)
QDRANT_URL=http://127.0.0.1:6334

# --- LLM y admin ---
OPENAI_API_KEY=
ADMIN_API_KEY=

# --- Docker Compose (publicacion en el host; no colisionar con proyecto-1) ---
# M2: POSTGRES_PUBLISH_PORT=15432, QDRANT_REST_PORT=6333
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taam
POSTGRES_PUBLISH_PORT=15433
QDRANT_REST_PORT=6334
QDRANT_GRPC_PORT=6335
# UI pgweb en el host (M2 usa 8081; http://127.0.0.1:8082 en el navegador)
PGWEB_PUBLISH_PORT=8082

# --- Ingesta protocolos TAAM (TASK-101) ---
# Solo PDF/Markdown de tipos_procedimiento subidos por admin; no corpus M2 ni prompts.
TAAM_PDF_MAX_MB=10
TAAM_QDRANT_COLLECTION=taam_protocolos
TAAM_CHUNK_SIZE=800
TAAM_CHUNK_OVERLAP=120
EMBEDDING_MODEL=text-embedding-3-small
INGESTA_REINTENTOS=3
INGESTA_BACKOFF_MAX_SEG=30
# STAFF_API_KEY=changeme-staff-key  # deprecado (TASK-105)
TAAM_CODIGO_EMPAREJAMIENTO_TTL_HORAS=24
TAAM_CODIGO_LONGITUD=8

# --- Auth staff JWT (TASK-105) ---
# Secreto para firmar tokens (minimo ~32 caracteres en produccion)
STAFF_JWT_SECRET=
STAFF_JWT_EXPIRE_HORAS=8
# Contraseñas demo para scripts.sembrar_usuarios_staff_demo (solo local)
STAFF_DEMO_ASISTENTE_PASSWORD=cambiar-demo-asistente
STAFF_DEMO_CLINICO_PASSWORD=cambiar-demo-clinico
STAFF_DEMO_ADMIN_PASSWORD=cambiar-demo-admin
# Deprecado: sustituido por JWT (TASK-105)
# STAFF_API_KEY=

# --- Agente Lili (guardrails de alcance postoperatorio) ---
# Filtra preguntas ajenas (programacion, finanzas, etc.) antes del LLM del agente.
AGENTE_GUARDRAILS_HABILITADO=true
# Modelo solo para clasificar mensajes dudosos; vacio = AGENTE_MODELO
# AGENTE_GUARDRAIL_MODELO=openai:gpt-4o-mini
AGENTE_MODELO=openai:gpt-4o-mini
AGENTE_RAG_K=4

# --- Semilla demo en arranque Docker (solo local) ---
TAAM_SEMBRAR_DEMO_HABILITADO=false
# Si la semilla esta habilitada: por defecto indexa a Qdrant (requiere OPENAI_API_KEY)
TAAM_SEMBRAR_DEMO_CON_INGESTA=true
