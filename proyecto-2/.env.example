# Copiar a `.env` en proyecto-2/ y completar valores reales.
# No commitear `.env` con secretos.

# --- Workspace (opcional) ---
# Directorio que contiene data/ (por defecto: padre de proyecto-2/)
# UAO_WORKSPACE_ROOT=

# --- API TAAM ---
# Puerto local / compose (M2 usa 8000)
API_PORT=8001

# Lista JSON (CORS). Incluir origen del frontend Vite TAAM (5174) y la API (8001).
ALLOWED_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","http://localhost:8001","http://127.0.0.1:8001"]

# --- Telegram (TASK-106) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Datos (TASK-99+) ---
# Desde el host con compose: localhost y POSTGRES_PUBLISH_PORT (15433 por defecto)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15433/taam?sslmode=disable

# Qdrant REST en el host (6334 por defecto; dentro de compose es http://qdrant:6333)
QDRANT_URL=http://127.0.0.1:6334

# --- LLM y admin ---
OPENAI_API_KEY=
ADMIN_API_KEY=

# --- Docker Compose (publicacion en el host; no colisionar con proyecto-1) ---
# M2: POSTGRES_PUBLISH_PORT=15432, QDRANT_REST_PORT=6333
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taam
POSTGRES_PUBLISH_PORT=15433
QDRANT_REST_PORT=6334
QDRANT_GRPC_PORT=6335

# --- Ingesta PDF TAAM (TASK-101) ---
TAAM_PDF_MAX_MB=10
TAAM_QDRANT_COLLECTION=taam_protocolos
TAAM_CHUNK_SIZE=800
TAAM_CHUNK_OVERLAP=120
EMBEDDING_MODEL=text-embedding-3-small
INGESTA_REINTENTOS=3
INGESTA_BACKOFF_MAX_SEG=30
