# Cursor: exclusion fuerte (agente, @, busqueda semantica). Ver:
# https://cursor.com/docs/reference/ignore-file
# Coherente con .gitignore donde aplica; comentarios en espanol latinoamericano.

# Secretos y variables de entorno (no commitear valores reales)
**/.env
**/.env.*
!**/.env.example
!proyecto-3/.env.example
secrets/
**/credentials.json
**/secrets.json
**/.aws/credentials
**/id_rsa
**/*.pem
**/*.key

# Descargas crudas: alto volumen; el corpus de trabajo esta en data/markdown/
data/raw/

# TAAM: PDFs y protocolos subidos (binarios; rutas en data/taam/procedimientos/)
data/taam/

# proyecto-3 Ruta B: runtime OpenFang (SQLite, JSONL sesiones; puede contener PII de demo Telegram)
proyecto-3/openfang/data/

# proyecto-3: salidas t-SNE (parquet, npy, HTML plotly)
proyecto-3/analisis_tsne/output/

# Entornos y caches de herramientas (no aportan al codigo fuente)
**/.venv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/__pycache__/
**/.cache/
**/node_modules/
**/dist/
**/.vite/
**/playwright-report/
**/test-results/
**/htmlcov/
**/coverage/

# Lockfile Python versionado: la lista por defecto de Cursor incluye *.lock
!uv.lock
!proyecto-1/uv.lock
!proyecto-2/uv.lock
!proyecto-3/uv.lock
